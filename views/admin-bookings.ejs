<%- include("partials/head",{title:"Booking requests"}) %><h1 class="h2 fw-bold">Venue booking requests</h1><div class="table-responsive mt-3"><table class="table"><thead><tr><th>Student</th><th>Activity</th><th>Venue</th><th>Date / time</th><th>People</th><th>Status</th><th>Review</th></tr></thead><tbody><% items.forEach(b=>{ %><tr><td><%= b.user?.name||"—" %></td><td><%= b.eventTitle %><br><small><%= b.purpose %></small></td><td><%= b.venue?.name||"—" %></td><td><%= date(b.date) %><br><%= b.startTime %>–<%= b.endTime %></td><td><%= b.attendees %></td><td><%= b.status %></td><td><form method="post" action="/admin/bookings/<%= b._id %>" class="d-flex gap-1"><select class="form-select form-select-sm" name="status"><option>Pending</option><option>Approved</option><option>Rejected</option></select><button class="btn btn-sm btn-primary">Save</button></form></td></tr><% }) %></tbody></table></div><%- include("partials/foot") %>