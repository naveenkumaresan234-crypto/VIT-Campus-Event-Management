<%- include("partials/head",{title:"Manage events"}) %><div class="eyebrow">ADMINISTRATION</div><h1 class="h2 fw-bold">Manage campus events</h1><div class="card my-4"><div class="card-body"><h2 class="h5 fw-bold">Create event</h2><form method="post" action="/admin/events" class="row g-3"><div class="col-md-6"><label class="form-label">Title</label><input name="title" class="form-control" required></div><div class="col-md-6"><label class="form-label">Category</label><select name="category" class="form-select"><option>Cultural</option><option>Technical</option><option>Academic</option><option>Sports</option><option>Workshop</option></select></div><div class="col-md-12"><label class="form-label">Description</label><textarea name="description" class="form-control" required></textarea></div><div class="col-md-4"><label class="form-label">Date</label><input name="date" type="datetime-local" class="form-control" required></div><div class="col-md-4"><label class="form-label">Venue</label><select name="venue" class="form-select"><% venues.forEach(v=>{ %><option value="<%= v._id %>"><%= v.name %></option><% }) %></select></div><div class="col-md-2"><label class="form-label">Capacity</label><input name="capacity" type="number" min="1" class="form-control" required></div><div class="col-md-2"><label class="form-label">Status</label><select name="status" class="form-select"><option>Draft</option><option>Published</option></select></div><div><button class="btn btn-primary">Save event</button></div></form></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Venue</th><th>Status</th><th></th></tr></thead><tbody><% events.forEach(e=>{ %><tr><td><b><%= e.title %></b><br><small><%= e.category %></small></td><td><%= date(e.date) %></td><td><%= e.venue?.name||"—" %></td><td><span class="badge text-bg-<%= e.status==="Published"?"success":"secondary" %>"><%= e.status %></span></td><td><form method="post" action="/admin/events/<%= e._id %>/delete" onsubmit="return confirm('Delete event?')"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr><% }) %></tbody></table></div><%- include("partials/foot") %>