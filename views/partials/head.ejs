<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title||"VIT Campus Events" %></title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/css/style.css" rel="stylesheet"></head><body><nav class="navbar navbar-expand-lg navbar-dark"><div class="container"><a class="navbar-brand" href="/">VIT Campus Events</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><div class="navbar-nav me-auto"><a class="nav-link" href="/events">Explore events</a><% if(user){ %><a class="nav-link" href="/my-registrations">My registrations</a><a class="nav-link" href="/book-venue">Book venue</a><a class="nav-link" href="/my-bookings">My bookings</a><% } %><% if(user&&user.role==="admin"){ %><a class="nav-link" href="/admin">Dashboard</a><a class="nav-link" href="/venues">Venues</a><a class="nav-link" href="/admin/events">Manage events</a><a class="nav-link" href="/admin/bookings">Bookings</a><% } %></div><div class="d-flex gap-2 align-items-center"><% if(user){ %><span class="text-white small"><%= user.name %></span><form method="post" action="/logout"><button class="btn btn-sm btn-outline-light">Logout</button></form><% }else{ %><a class="btn btn-sm btn-outline-light" href="/login">Login</a><a class="btn btn-sm btn-light" href="/register">Register</a><% } %></div></div></div></nav><main class="container py-4"><% if(flash){ %><div class="alert alert-<%= flash.type %>"><%= flash.text %></div><% } %>