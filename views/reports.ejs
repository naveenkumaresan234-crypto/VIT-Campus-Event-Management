<%- include("partials/head",{title:"Reports"}) %><div class="eyebrow">ANALYTICS</div><h1 class="h2 fw-bold">Campus activity reports</h1><div class="row g-3 mt-2"><% [["Events",r.eventCount],["Active venues",r.venueCount],["Students",r.studentCount],["Registrations",r.regCount]].forEach(x=>{ %><div class="col-6 col-lg-3"><div class="card stat-card"><div class="card-body"><div class="text-muted"><%= x[0] %></div><div class="display-6 fw-bold"><%= x[1] %></div></div></div></div><% }) %></div><div class="card mt-4"><div class="card-body"><h2 class="h5 fw-bold">Booking status breakdown</h2><% r.statuses.forEach(s=>{ %><p class="mb-2"><b><%= s._id %></b><span class="float-end"><%= s.count %></span></p><div class="progress mb-3"><div class="progress-bar" style="width:<%= Math.max(5,s.count*100/Math.max(1,r.statuses.reduce((a,b)=>a+b.count,0))) %>%"></div></div><% }) %></div></div><%- include("partials/foot") %>