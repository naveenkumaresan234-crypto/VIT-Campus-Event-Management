<%- include("partials/head",{title:"VIT venues"}) %><div class="eyebrow">CAMPUS FACILITIES</div><h1 class="h2 fw-bold">Venue directory</h1><p class="text-muted">Preloaded VIT Vellore auditorium and conference facilities.</p><div class="row g-3 mb-4"><% venues.forEach(v=>{ %><div class="col-md-6 col-lg-4"><div class="card h-100"><div class="card-body"><span class="badge text-bg-primary mb-2">Capacity <%= v.capacity %></span><h2 class="h5 fw-bold"><%= v.name %></h2><p class="small text-muted"><%= v.location %></p><p class="small"><%= v.facilities.join(" · ") %></p><div class="d-flex justify-content-between align-items-center"><span class="badge text-bg-<%= v.isActive?"success":"secondary" %>"><%= v.isActive?"Active":"Inactive" %></span><form method="post" action="/venues/<%= v._id %>/toggle"><button class="btn btn-sm btn-outline-primary">Toggle</button></form></div></div></div></div><% }) %></div><div class="card"><div class="card-body"><h2 class="h5 fw-bold">Add a campus venue</h2><form method="post" action="/venues" class="row g-2"><div class="col-md-3"><input class="form-control" name="name" placeholder="Venue name" required></div><div class="col-md-3"><input class="form-control" name="location" placeholder="Location" required></div><div class="col-md-2"><input class="form-control" name="capacity" type="number" placeholder="Capacity" min="1" required></div><div class="col-md-3"><input class="form-control" name="facilities" placeholder="Facilities, comma-separated"></div><div class="col-md-1"><button class="btn btn-primary">Add</button></div></form></div></div><%- include("partials/foot") %>