<%- include("partials/head",{title:"My registrations"}) %><h1 class="h2 fw-bold">My event registrations</h1><div class="table-responsive mt-3"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Venue</th><th>Status</th><th></th></tr></thead><tbody><% items.forEach(r=>{ %><tr><td><%= r.event?.title||"Event removed" %></td><td><%= r.event?date(r.event.date):"—" %></td><td><%= r.event?.venue?.name||"—" %></td><td><%= r.status %></td><td><% if(r.event&&r.status==="Registered"){ %><form method="post" action="/events/<%= r.event._id %>/cancel"><button class="btn btn-sm btn-outline-danger">Cancel</button></form><% } %></td></tr><% }) %></tbody></table></div><%- include("partials/foot") %>