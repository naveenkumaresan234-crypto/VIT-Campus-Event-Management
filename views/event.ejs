<%- include("partials/head",{title:event.title}) %><a href="/events">← All events</a><div class="row g-4 mt-2"><div class="col-lg-8"><span class="badge text-bg-primary"><%= event.category %></span><h1 class="display-6 fw-bold mt-3"><%= event.title %></h1><p class="text-muted"><%= date(event.date) %></p><p class="fs-5"><%= event.description %></p><hr><p><b>Venue:</b> <%= event.venue?event.venue.name:"To be announced" %></p><p><b>Capacity:</b> <%= event.capacity %> · <b>Registered:</b> <%= count %></p></div><div class="col-lg-4"><div class="card"><div class="card-body"><h2 class="h5 fw-bold">Event registration</h2><% if(!user){ %><a class="btn btn-primary w-100" href="/login">Login to register</a><% }else if(user.role==="admin"){ %><p>Admin preview</p><% }else if(registered){ %><p class="text-success">You're registered!</p><form method="post" action="/events/<%= event._id %>/cancel"><button class="btn btn-outline-danger w-100">Cancel registration</button></form><% }else{ %><form method="post" action="/events/<%= event._id %>/register"><button class="btn btn-primary w-100" <%= count>=event.capacity?"disabled":"" %>>Register now</button></form><% } %></div></div></div></div><%- include("partials/foot") %>