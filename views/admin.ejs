<%- include("partials/head",{title:"Admin dashboard"}) %><div class="eyebrow">CONTROL CENTRE</div><h1 class="h2 fw-bold">Admin dashboard</h1><p class="text-muted">VIT Vellore event operations at a glance.</p><div class="row g-3 my-3"><% [{t:"Students",v:stats.students},{t:"Events",v:stats.events},{t:"Active venues",v:stats.venues},{t:"Registrations",v:stats.registrations},{t:"Pending bookings",v:stats.pending}].forEach(x=>{ %><div class="col-6 col-lg"><div class="card stat-card"><div class="card-body"><div class="text-muted"><%= x.t %></div><div class="display-6 fw-bold"><%= x.v %></div></div></div></div><% }) %></div><div class="d-flex flex-wrap gap-2 my-4"><a class="btn btn-primary" href="/admin/events">Manage events</a><a class="btn btn-outline-primary" href="/venues">Manage venues</a><a class="btn btn-outline-primary" href="/admin/bookings">Booking requests</a><a class="btn btn-outline-primary" href="/admin/registrations">Registrations</a><a class="btn btn-outline-primary" href="/admin/reports">Reports</a></div><h2 class="h5 fw-bold">Recent booking requests</h2><div class="table-responsive"><table class="table"><thead><tr><th>Student</th><th>Activity</th><th>Venue</th><th>Status</th></tr></thead><tbody><% bookings.forEach(b=>{ %><tr><td><%= b.user?.name||"—" %></td><td><%= b.eventTitle %></td><td><%= b.venue?.name||"—" %></td><td><%= b.status %></td></tr><% }) %></tbody></table></div><%- include("partials/foot") %>