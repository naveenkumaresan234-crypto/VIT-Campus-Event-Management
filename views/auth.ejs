<%- include("partials/head",{title:mode==="login"?"Login":"Student registration"}) %><div class="form-card mx-auto"><div class="eyebrow">VIT VELLORE PORTAL</div><h1 class="h3 fw-bold mb-4"><%= mode==="login"?"Welcome back":"Create student account" %></h1><form method="post" action="/<%= mode %>"><% if(mode==="register"){ %><label class="form-label">Full name</label><input class="form-control mb-3" name="name" required><% } %><label class="form-label">Email address</label><input class="form-control mb-3" type="email" name="email" required><label class="form-label">Password</label><input class="form-control mb-3" type="password" name="password" minlength="8" required><button class="btn btn-primary w-100"><%= mode==="login"?"Sign in":"Create account" %></button></form><p class="text-center mt-3 mb-0"><%= mode==="login"?"New student?":"Already registered?" %> <a href="/<%= mode==="login"?"register":"login" %>"><%= mode==="login"?"Register":"Login" %></a></p></div><%- include("partials/foot") %>