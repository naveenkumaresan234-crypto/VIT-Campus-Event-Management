<%- include("partials/head",{title:"My bookings"}) %><h1 class="h2 fw-bold">My venue bookings</h1><div class="table-responsive mt-3"><table class="table"><thead><tr><th>Activity</th><th>Venue</th><th>Date</th><th>Time</th><th>Status</th></tr></thead><tbody><% items.forEach(b=>{ %><tr><td><%= b.eventTitle %></td><td><%= b.venue?.name||"—" %></td><td><%= date(b.date) %></td><td><%= b.startTime %>–<%= b.endTime %></td><td><%= b.status %></td></tr><% }) %></tbody></table></div><%- include("partials/foot") %>