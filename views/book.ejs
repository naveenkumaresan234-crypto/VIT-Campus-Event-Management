<%- include("partials/head",{title:"Book a venue"}) %><div class="form-card wide-card mx-auto"><div class="eyebrow">VENUE REQUEST</div><h1 class="h3 fw-bold">Request a campus venue</h1><p class="text-muted">Requests are subject to administrator approval.</p><form method="post" action="/book-venue"><label class="form-label">Venue</label><select class="form-select mb-3" name="venue" required><% venues.forEach(v=>{ %><option value="<%= v._id %>"><%= v.name %> · <%= v.capacity %> seats</option><% }) %></select><label class="form-label">Event title</label><input class="form-control mb-3" name="eventTitle" required><div class="row"><div class="col-md-6"><label class="form-label">Date</label><input class="form-control mb-3" type="date" name="date" required></div><div class="col-md-3"><label class="form-label">Start</label><input class="form-control mb-3" type="time" name="startTime" required></div><div class="col-md-3"><label class="form-label">End</label><input class="form-control mb-3" type="time" name="endTime" required></div></div><label class="form-label">Expected attendees</label><input class="form-control mb-3" type="number" min="1" name="attendees" required><label class="form-label">Purpose</label><textarea class="form-control mb-3" name="purpose" required></textarea><button class="btn btn-primary">Submit request</button></form></div><%- include("partials/foot") %>